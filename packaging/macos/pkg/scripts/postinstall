#!/bin/sh
set -eu

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
LAUNCH_AGENT="/Library/LaunchAgents/com.rsteye.rsteye.plist"

install -m 644 "$SCRIPT_DIR/com.rsteye.rsteye.plist" "$LAUNCH_AGENT"

console_uid="$(stat -f '%u' /dev/console)"
if [ "$console_uid" -gt 0 ]; then
    launchctl bootout "gui/$console_uid/com.rsteye.rsteye" 2>/dev/null || true
    launchctl bootstrap "gui/$console_uid" "$LAUNCH_AGENT" 2>/dev/null || true
fi

exit 0
